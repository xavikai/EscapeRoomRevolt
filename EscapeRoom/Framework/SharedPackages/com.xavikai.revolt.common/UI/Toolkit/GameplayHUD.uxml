<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Packages/com.xavikai.revolt.common/UI/Toolkit/GameplayHUD.uss" />
    <ui:VisualElement name="gameplay-root" class="gameplay-root">
        <ui:VisualElement name="hud-layer" class="hud-layer" picking-mode="Ignore">
            <ui:VisualElement name="crosshair" class="crosshair crosshair--default" picking-mode="Ignore" />
            <ui:Label name="interaction-prompt" class="interaction-prompt" picking-mode="Ignore" />
            <ui:Label name="objective-text" class="objective-text" picking-mode="Ignore" />
            <ui:VisualElement name="gameover-timer-hud" class="gameover-timer-hud" picking-mode="Ignore">
                <ui:Label name="gameover-timer-title" text="TIEMPO RESTANTE" class="gameover-timer-title" />
                <ui:Label name="gameover-timer-value" text="01:00" class="gameover-timer-value" />
                <ui:VisualElement class="gameover-timer-track">
                    <ui:VisualElement name="gameover-timer-fill" class="gameover-timer-fill" />
                </ui:VisualElement>
            </ui:VisualElement>



            <ui:VisualElement name="flashlight-hud" class="flashlight-hud" picking-mode="Ignore">
                <ui:VisualElement class="instrument-header">
                    <ui:Label text="LINTERNA // BAT-01" class="instrument-title" />
                    <ui:Label name="flashlight-state" text="ESPERA" class="instrument-state" />
                </ui:VisualElement>
                <ui:VisualElement class="battery-row">
                    <ui:VisualElement class="battery-shell">
                        <ui:VisualElement name="flashlight-fill" class="battery-fill" />
                    </ui:VisualElement>
                    <ui:Label name="flashlight-percent" text="100%" class="battery-percent" />
                </ui:VisualElement>
                <ui:Label text="[F] LUZ   [R] BATERÍA   [G] SOLTAR" class="instrument-help" />
            </ui:VisualElement>







            <ui:VisualElement name="hotbar" class="hotbar" picking-mode="Position" />
            <ui:Label name="subtitle" class="subtitle" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="modal-layer" class="modal-layer">
            <ui:VisualElement name="inventory-panel" class="modal-card inventory-panel">
                <ui:VisualElement class="modal-heading">
                    <ui:Label text="INVENTARIO DE EVIDENCIAS" class="modal-title" />
                    <ui:Button name="inventory-close" text="CERRAR  [ESC]" class="text-button" />
                </ui:VisualElement>
                <ui:VisualElement class="inventory-body">
                    <ui:VisualElement name="inventory-grid" class="inventory-grid" />
                    <ui:VisualElement class="item-detail">
                        <ui:Image name="inventory-detail-icon" class="detail-icon" />
                        <ui:Label name="inventory-detail-name" text="SIN SELECCIÓN" class="detail-name" />
                        <ui:Label name="inventory-detail-description" class="detail-description" />
                        <ui:VisualElement class="detail-actions">
                            <ui:Button name="inventory-use" text="USAR / EQUIPAR" class="primary-button" />
                            <ui:Button name="inventory-quick-assign" text="ACCESO RÁPIDO" class="secondary-button" />
                            <ui:Button name="inventory-examine" text="EXAMINAR" class="secondary-button" />
                            <ui:Button name="inventory-combine" text="COMBINAR" class="secondary-button" />
                            <ui:Button name="inventory-drop" text="SOLTAR" class="danger-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="note-panel" class="modal-card note-panel">
                <ui:VisualElement class="modal-heading">
                    <ui:Label text="DOCUMENTO RECUPERADO" class="modal-title" />
                    <ui:Button name="note-close" text="CERRAR  [ESC]" class="text-button" />
                </ui:VisualElement>
                <ui:ScrollView class="note-scroll">
                    <ui:Label name="note-content" class="note-content" />
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="keypad-panel" class="modal-card keypad-panel">
                <ui:Label text="CONTROL DE ACCESO" class="modal-title centered" />
                <ui:Label name="keypad-display" text="----" class="keypad-display" />
                <ui:VisualElement name="keypad-grid" class="keypad-grid" />
                <ui:Button name="keypad-close" text="CANCELAR  [ESC]" class="text-button" />
            </ui:VisualElement>

            <ui:VisualElement name="examiner-panel" class="modal-card examiner-panel">
                <ui:VisualElement class="modal-heading">
                    <ui:Label name="examiner-title" text="ANÁLISIS DE OBJETO" class="modal-title" />
                    <ui:Button name="examiner-close" text="CERRAR  [ESC]" class="text-button" />
                </ui:VisualElement>
                <ui:Image name="examiner-image" class="examiner-image" />
                <ui:Label name="examiner-description" class="examiner-description" />
                <ui:VisualElement class="examiner-footer">
                    <ui:Label text="ARRASTRAR: ROTAR  //  RUEDA: ZOOM" class="instrument-help" />
                    <ui:Button name="examiner-combine" text="COMBINAR CON OBJETO ACTIVO" class="primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
