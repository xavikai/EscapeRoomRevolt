.viewfinder-frame {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none;
}
.viewfinder-bar {
    position: absolute; left: 0; right: 0; height: 68px; background-color: rgb(0, 0, 0);
}
.viewfinder-bar--top { top: 0; }
.viewfinder-bar--bottom { bottom: 0; }
.viewfinder-rec {
    position: absolute; left: 18px; top: 12px;
    flex-direction: row; align-items: center; display: none;
}
.viewfinder-rec-dot { width: 9px; height: 9px; border-radius: 5px; background-color: rgb(197, 51, 43); margin-right: 6px; }
.viewfinder-rec-label { color: rgb(224, 96, 86); font-size: 13px; letter-spacing: 2px; -unity-font-style: bold; margin-right: 10px; }
.viewfinder-timecode { color: var(--green); font-size: 13px; letter-spacing: 1px; }
.viewfinder-zoom {
    position: absolute; left: 50%; top: 14px; translate: -50% 0; width: 160px;
    flex-direction: row; align-items: center;
}
.viewfinder-zoom-label { color: var(--green); font-size: 11px; -unity-font-style: bold; }
.viewfinder-zoom-track {
    flex-grow: 1; height: 3px; margin: 0 8px; background-color: rgba(105, 213, 115, 0.25);
}
.viewfinder-zoom-marker {
    position: absolute; top: -3px; width: 3px; height: 9px; background-color: var(--green);
    left: 8%; transition-property: left; transition-duration: 0.2s;
}
.viewfinder-chip { position: absolute; color: var(--green); font-size: 11px; letter-spacing: 1px; -unity-font-style: bold; }
.viewfinder-chip--hd { left: 18px; bottom: 46px; }
.viewfinder-chip--auto { left: 18px; bottom: 30px; color: rgb(200, 224, 202); -unity-font-style: normal; }
.viewfinder-chip--fstop { left: 18px; bottom: 14px; color: rgb(200, 224, 202); -unity-font-style: normal; }
.viewfinder-chip--res { right: 18px; bottom: 14px; color: rgb(200, 224, 202); -unity-font-style: normal; }
.sanity-hud {
    position: absolute; left: 32px; bottom: 34px; width: 260px;
    padding: 12px 14px; background-color: rgba(11, 14, 13, 0.82);
    border-left-width: 2px; border-left-color: rgb(96, 132, 130); display: none;
}
.sanity-track { height: 5px; margin-top: 9px; background-color: rgb(28, 35, 34); }
.sanity-fill { height: 100%; width: 100%; background-color: rgb(101, 166, 159); transition-property: width, background-color; transition-duration: 0.25s; }
.sanity-percent { color: rgb(161, 181, 175); font-size: 10px; margin-top: 5px; -unity-text-align: middle-right; }
.sanity-hud--uneasy .sanity-fill { background-color: rgb(183, 157, 83); }
.sanity-hud--distressed .sanity-fill { background-color: rgb(185, 93, 61); }
.sanity-hud--critical .sanity-fill { background-color: rgb(176, 43, 39); }
.sanity-hud--critical { border-left-color: rgb(176, 43, 39); }
.vitals-hud {
    position: absolute; left: 32px; top: 32px; width: 280px; padding: 12px 14px;
    background-color: rgba(11, 14, 13, 0.82); border-left-width: 2px; border-left-color: rgb(145, 58, 52); display: none;
}
.vitals-row { flex-direction: row; align-items: center; margin-top: 8px; }
.vitals-label { width: 48px; color: rgb(167, 166, 149); font-size: 9px; }
.vitals-track { flex-grow: 1; height: 6px; background-color: rgb(28, 32, 31); }
.vitals-fill { height: 100%; width: 100%; transition-property: width; transition-duration: 0.16s; }
.health-fill { background-color: rgb(177, 67, 57); }
.stamina-fill { background-color: rgb(105, 166, 135); }
.vitals-percent { width: 38px; margin-left: 7px; color: rgb(194, 191, 172); font-size: 9px; -unity-text-align: middle-right; }
.camcorder-hud {
    position: absolute; right: 32px; top: 32px; width: 310px; padding: 12px 14px;
    background-color: rgba(6, 15, 9, 0.82); border-left-width: 2px; border-left-color: rgb(91, 181, 102); display: none;
}
.nightvision-fill { background-color: rgb(105, 213, 115); }
.recording-target { margin-top: 8px; color: rgb(150, 201, 157); font-size: 10px; letter-spacing: 0.8px; }
.recording-track { height: 4px; margin-top: 5px; background-color: rgb(22, 45, 28); }
.recording-fill { width: 0%; height: 100%; background-color: rgb(128, 232, 139); transition-property: width; transition-duration: 0.08s; }
