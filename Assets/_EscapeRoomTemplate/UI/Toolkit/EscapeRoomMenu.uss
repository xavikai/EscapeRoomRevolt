.menu-root {
    --color-accent: rgb(125, 108, 70);
    --color-text: rgb(230, 225, 205);
    --color-title: rgb(223, 207, 158);
    --color-button-bg: rgb(51, 48, 39);
    --color-button-bg-hover: rgb(79, 73, 57);
    flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(5, 7, 8, 0.82);
}
.document-frame { width: 760px; min-height: 460px; padding: 34px; background-color: rgb(32, 31, 25); border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px; border-top-color: var(--color-accent); border-bottom-color: var(--color-accent); border-left-color: var(--color-accent); border-right-color: var(--color-accent); }
.menu-logo { width: 72px; height: 72px; align-self: center; margin-bottom: 14px; }
.title { color: var(--color-title); font-size: 28px; -unity-font-style: bold; letter-spacing: 3px; margin-bottom: 20px; }
.screen-content { flex-grow: 1; max-height: 560px; }
.menu-button { height: 42px; margin-bottom: 8px; color: var(--color-text); background-color: var(--color-button-bg); border-left-width: 3px; border-left-color: rgb(151, 46, 39); }
.menu-button:hover { background-color: var(--color-button-bg-hover); }
.setting-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; color: var(--color-text); }
.menu-button--quiet { opacity: 0.72; margin-top: 12px; }
.menu-button--danger { border-left-color: rgb(174, 53, 43); background-color: rgb(65, 35, 31); }
.save-slot-card { height: 104px; flex-direction: row; align-items: stretch; margin-bottom: 10px; background-color: rgb(42, 41, 34); border-left-width: 2px; border-left-color: var(--color-accent); }
.save-slot-preview { width: 166px; background-color: rgb(15, 17, 17); border-right-width: 1px; border-right-color: rgb(91, 82, 61); }
.save-slot-info { flex-grow: 1; padding: 10px 14px; justify-content: center; }
.save-slot-title { color: var(--color-title); font-size: 15px; -unity-font-style: bold; letter-spacing: 2px; }
.save-slot-meta { color: rgb(178, 174, 157); font-size: 12px; margin-top: 2px; }
.save-slot-empty { color: rgb(112, 111, 103); font-size: 13px; margin-top: 8px; letter-spacing: 1px; }
.save-slot-actions { width: 132px; padding: 8px; justify-content: center; }
.slot-action { height: 34px; margin-bottom: 5px; color: var(--color-text); background-color: rgb(65, 60, 47); }
.slot-action:hover { background-color: rgb(91, 82, 61); }
.slot-action--danger { color: rgb(224, 154, 143); background-color: rgb(59, 37, 34); }
.confirmation-message { color: var(--color-text); font-size: 18px; white-space: normal; margin: 30px 0; }
.operation-status { color: rgb(184, 205, 153); -unity-font-style: bold; letter-spacing: 1px; margin-top: 8px; }
.settings-section { color: var(--color-title); font-size: 15px; -unity-font-style: bold; letter-spacing: 2px; margin-top: 22px; margin-bottom: 10px; }
.binding-row { min-height: 38px; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 5px; }
.binding-label { color: rgb(216, 211, 191); min-width: 230px; }
.binding-button { width: 300px; height: 34px; color: var(--color-text); background-color: var(--color-button-bg); border-left-width: 2px; border-left-color: var(--color-accent); }
.binding-button:hover { background-color: var(--color-button-bg-hover); }
